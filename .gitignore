# The web app's own ignores (Next.js, TypeScript, Lighthouse) live in apps/web/.gitignore.

# secrets and local settings
.env
.env*.local
*.pem
.vercel
.DS_Store

# dependencies
node_modules/
.venv/

# python
__pycache__/
*.py[cod]
.coverage
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# embedding model cache
.cache/

# Playwright
apps/web/test-results/
apps/web/playwright-report/

# local only: project docs and AI-agent notes (Claude Code; `next dev` writes AGENTS.md)
/docs
CLAUDE.md
CLAUDE.local.md
AGENTS.md
.claudeignore
.claude/

# A stopped eval run keeps its finished texts here until the report is written (make eval --resume)
eval/reports/*.partial.jsonl
