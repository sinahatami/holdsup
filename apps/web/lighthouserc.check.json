{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:3200/check/22222222-2222-4222-8222-222222222222"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox",
        "throttlingMethod": "devtools"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "/check/",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 300
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.05
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 265000
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
