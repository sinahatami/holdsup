# Copy to .env and fill in DEVELOPMENT keys only. Never commit .env.

# --- API ---
APP_ENV=development
WEB_ORIGIN=http://localhost:3000
# Neon gives postgres://...?sslmode=require; it is converted for asyncpg automatically.
DATABASE_URL=postgresql://postgres:dev@localhost:5432/postgres
# New (not cached) checks per client address per hour.
CHECKS_PER_HOUR=10
# Reports of a wrong match per client address per hour.
REPORTS_PER_HOUR=20
# Proxies in front of the API that append to X-Forwarded-For (0 = trust no header).
TRUSTED_PROXIES=0
LOG_LEVEL=INFO
# Git commit shown on receipts next to the version (the image build sets it).
APP_COMMIT=

# --- Model providers (live) ---
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# --- Model providers (offline only: eval/ and ml/, never live traffic) ---
GEMINI_API_KEY=

# --- Data sources (optional) ---
DATACOMMONS_API_KEY=

# --- Web ---
HOLDSUP_API_URL=http://localhost:8000
# The site's public address, for the pictures in shared links. Optional on Vercel, which
# works it out from the deployment.
NEXT_PUBLIC_SITE_URL=
