# Copy to .env and fill in DEVELOPMENT keys only. Never commit .env.

# --- API ---
APP_ENV=development
WEB_ORIGIN=http://localhost:3000
# Neon gives postgres://...?sslmode=require; it is converted for asyncpg automatically.
DATABASE_URL=postgresql://postgres:dev@localhost:5432/postgres

# --- Model providers (live) ---
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# --- Model providers (offline only: eval/ and ml/, never live traffic) ---
GEMINI_API_KEY=

# --- Data sources (optional) ---
DATACOMMONS_API_KEY=

# --- Web ---
HOLDSUP_API_URL=http://localhost:8000
